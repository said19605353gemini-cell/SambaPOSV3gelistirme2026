<Window x:Class="Samba.Presentation.Shell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:cal="http://www.codeplex.com/CompositeWPF"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        Title="SambaPOS Modern" WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow"
        WindowState="Maximized" MinWidth="1024" MinHeight="700"
        SnapsToDevicePixels="True" Closing="WindowClosing" Loaded="WindowLoaded" Icon="/Samba.Presentation;component/apple.ico">
    <Window.Background>
        <SolidColorBrush Color="#0F172A"/>
    </Window.Background>
    <Grid Name="MainGrid">
        <Grid.LayoutTransform>
            <ScaleTransform/>
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>
        
        <!-- Modern Top Header Bar -->
        <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2563EB" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                        <Image Source="/Samba.Presentation;component/Images/apple-icon.png" Stretch="Uniform" Margin="5"/>
                    </Border>
                    <TextBlock MouseWheel="UIElement_OnMouseWheel" FontWeight="Bold" FontSize="20" Foreground="#F8FAFC" 
                               MouseDown="TextBlockMouseDown" VerticalAlignment="Center" FontFamily="Segoe UI, Inter, Arial">
                        SambaPOS <Run Text="MODERN" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>

                <!-- Clock & Status Bar -->
                <Border Grid.Column="2" Background="#0F172A" CornerRadius="8" Padding="12,6" BorderBrush="#334155" BorderThickness="1">
                    <TextBlock Name="TimeLabel" FontSize="15" FontWeight="SemiBold" Foreground="#38BDF8" 
                               VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="Consolas, Lucida Console">SAAT</TextBlock>
                </Border>
            </Grid>
        </Border>

        <!-- Main Workspace (Responsive) -->
        <TabControl Style="{StaticResource BorderlessTabControlStyle}"
                    Margin="0" Padding="0" Grid.Row="1" cal:RegionManager.RegionName="MainRegion" SelectedIndex="0" Name="MainTabControl">
            <TabControl.ItemContainerStyle>
                <Style TargetType="{x:Type TabItem}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>
        </TabControl>

        <!-- Modern Bottom Bar -->
        <Border Grid.Row="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="8,4">
            <Grid>
                <Grid.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Padding" Value="12,6"/>
                        <Setter Property="Margin" Value="4,0"/>
                    </Style>
                </Grid.Resources>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <ItemsControl Grid.Column="0" cal:RegionManager.RegionName="UserRegion" Name="UserRegion" Background="Transparent">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <ItemsControl Grid.Column="1" cal:RegionManager.RegionName="MessageRegion" Name="MessageRegion" Background="Transparent">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <ItemsControl Grid.Column="3" cal:RegionManager.RegionName="RightUserRegion" Name="RightUserRegion" Background="Transparent">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</Window>
