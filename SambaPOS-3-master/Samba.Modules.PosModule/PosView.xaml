<UserControl x:Class="Samba.Modules.PosModule.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:cal="clr-namespace:Microsoft.Practices.Prism.Regions;assembly=Microsoft.Practices.Prism" 
             xmlns:Common="clr-namespace:Samba.Presentation.Common;assembly=Samba.Presentation.Common" mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1024" 
             FocusVisualStyle="{x:Null}"
             Focusable="True"
             PreviewTextInput="UserControl_PreviewTextInput" Loaded="UserControl_Loaded">

    <TabControl Name="LayoutTabControl" Background="Transparent" FocusVisualStyle="{x:Null}" Style="{StaticResource BorderlessTabControlStyle}"
                    Grid.Column="0" BorderThickness="0"
                    Margin="0" Padding="0">
        <TabControl.ItemContainerStyle>
            <Style TargetType="{x:Type TabItem}">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Style>
        </TabControl.ItemContainerStyle>

        <!-- Responsive Grid with Slate Background and GridSplitter -->
        <Grid Name="Grid1" Background="#0F172A">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42*" MinWidth="340"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="58*" MinWidth="420"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Ticket / Order List (Card Container) -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="10" Margin="8,8,4,8" BorderBrush="#334155" BorderThickness="1">
                <TabControl cal:RegionManager.RegionName="{x:Static Common:RegionNames.PosMainRegion}" 
                        Background="Transparent"
                        BorderThickness="0"
                        Margin="4" Padding="0"
                        FocusVisualStyle="{x:Null}"
                        Name="TicketRegion">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="{x:Type TabItem}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                    </TabControl.ItemContainerStyle>
                </TabControl>
            </Border>

            <!-- Responsive Splitter -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                          Background="Transparent" ShowsPreview="False" Cursor="SizeWE"/>

            <!-- Right: Menu & Category Selector (Card Container) -->
            <Border Grid.Column="2" Background="#1E293B" CornerRadius="10" Margin="4,8,8,8" BorderBrush="#334155" BorderThickness="1">
                <TabControl cal:RegionManager.RegionName="{x:Static Common:RegionNames.PosSubRegion}"                        
                        FocusVisualStyle="{x:Null}"
                        Background="Transparent"
                        BorderThickness="0"
                        Margin="4" Padding="0"
                        Name="MenuRegion">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="{x:Type TabItem}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                    </TabControl.ItemContainerStyle>
                </TabControl>
            </Border>
        </Grid>

        <TabControl Name="Grid2" FocusVisualStyle="{x:Null}" Style="{StaticResource BorderlessTabControlStyle}"
                    Background="Transparent"
                    BorderThickness="0"
                    Margin="-1"
                    Padding="0">
            <TabControl.ItemContainerStyle>
                <Style TargetType="{x:Type TabItem}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>
        </TabControl>
    </TabControl>

</UserControl>
